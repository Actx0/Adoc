{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Actx0",
  "description": "Zero-latency memory platform for AI agents",
  "theme": "mint",
  "icons": {
    "library": "lucide"
  },
  "colors": {
    "primary": "#37352F",
    "light": "#6B6966",
    "dark": "#F7F6F3"
  },
  "logo": {
    "light": "/logo.png",
    "dark": "/logo.png"
  },
  "favicon": "/favicon.png",
  "navbar": {
    "links": [
      {
        "label": "Home",
        "href": "https://actx0.com"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Actx0/Actx0",
      "linkedin": "https://www.linkedin.com/company/actx0"
    }
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": ["python", "javascript", "go", "curl"],
      "defaults": "required",
      "prefill": true,
      "autogenerate": false
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Get Started",
        "icon": "rocket",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "actx0-platform/quickstart"
            ]
          }
        ]
      },
      {
        "tab": "Platform",
        "icon": "cloud",
        "groups": [
          {
            "group": "Actx0 Platform",
            "pages": [
              "actx0-platform/overview",
              "actx0-platform/agent",
              "actx0-platform/knowledge",
              "actx0-platform/prompt",
              "actx0-platform/mcp"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "icon": "code",
        "groups": [
          {
            "group": "Getting Started",
            "icon": "rocket",
            "pages": [
              "api-reference/overview"
            ]
          },
          {
            "group": "Me",
            "icon": "user",
            "openapi": "openapi.yaml",
            "pages": [
              "GET /me"
            ]
          },
          {
            "group": "Workspaces",
            "icon": "building-2",
            "openapi": "openapi.yaml",
            "pages": [
              "POST /workspaces",
              "GET /workspaces",
              "GET /workspaces/{workspaceId}",
              "PUT /workspaces/{workspaceId}",
              "DELETE /workspaces/{workspaceId}"
            ]
          },
          {
            "group": "Agents",
            "icon": "bot",
            "openapi": "openapi.yaml",
            "pages": [
              "POST /workspaces/{workspaceId}/agents",
              "GET /workspaces/{workspaceId}/agents",
              "GET /workspaces/{workspaceId}/agents/{agentId}",
              "PUT /workspaces/{workspaceId}/agents/{agentId}",
              "DELETE /workspaces/{workspaceId}/agents/{agentId}"
            ]
          },
          {
            "group": "Sessions",
            "icon": "messages-square",
            "openapi": "openapi.yaml",
            "pages": [
              "POST /workspaces/{workspaceId}/agents/{agentId}/sessions",
              "GET /workspaces/{workspaceId}/agents/{agentId}/sessions",
              "GET /workspaces/{workspaceId}/agents/{agentId}/sessions/{sessionId}",
              "GET /workspaces/{workspaceId}/agents/{agentId}/sessions/by-labels",
              "PUT /workspaces/{workspaceId}/agents/{agentId}/sessions/by-labels",
              "DELETE /workspaces/{workspaceId}/agents/{agentId}/sessions/by-labels"
            ]
          },
          {
            "group": "Messages",
            "icon": "message-square",
            "openapi": "openapi.yaml",
            "pages": [
              "POST /workspaces/{workspaceId}/agents/{agentId}/sessions/{sessionId}/messages",
              "POST /workspaces/{workspaceId}/agents/{agentId}/sessions/{sessionId}/messages/batch",
              "GET /workspaces/{workspaceId}/agents/{agentId}/sessions/{sessionId}/messages",
              "POST /workspaces/{workspaceId}/agents/{agentId}/sessions/{sessionId}/messages/search",
              "GET /workspaces/{workspaceId}/agents/{agentId}/sessions/{sessionId}/messages/{messageId}",
              "PUT /workspaces/{workspaceId}/agents/{agentId}/sessions/{sessionId}/messages/{messageId}",
              "DELETE /workspaces/{workspaceId}/agents/{agentId}/sessions/{sessionId}/messages/{messageId}",
              "DELETE /workspaces/{workspaceId}/agents/{agentId}/sessions/{sessionId}/messages/batch"
            ]
          },
          {
            "group": "Memories",
            "icon": "cpu",
            "openapi": "openapi.yaml",
            "pages": [
              "POST /workspaces/{workspaceId}/agents/{agentId}/sessions/{sessionId}/memories",
              "POST /workspaces/{workspaceId}/agents/{agentId}/sessions/{sessionId}/memories/batch",
              "GET /workspaces/{workspaceId}/agents/{agentId}/sessions/{sessionId}/memories",
              "POST /workspaces/{workspaceId}/agents/{agentId}/sessions/{sessionId}/memories/search",
              "GET /workspaces/{workspaceId}/agents/{agentId}/sessions/{sessionId}/memories/{memoryId}",
              "PUT /workspaces/{workspaceId}/agents/{agentId}/sessions/{sessionId}/memories/{memoryId}",
              "DELETE /workspaces/{workspaceId}/agents/{agentId}/sessions/{sessionId}/memories/{memoryId}",
              "DELETE /workspaces/{workspaceId}/agents/{agentId}/sessions/{sessionId}/memories/batch"
            ]
          },
          {
            "group": "Prompts",
            "icon": "file-text",
            "openapi": "openapi.yaml",
            "pages": [
              "POST /workspaces/{workspaceId}/prompts",
              "GET /workspaces/{workspaceId}/prompts",
              "GET /workspaces/{workspaceId}/prompts/{promptId}",
              "DELETE /workspaces/{workspaceId}/prompts/{promptId}",
              "POST /workspaces/{workspaceId}/prompts/{promptId}/versions",
              "GET /workspaces/{workspaceId}/prompts/{promptId}/versions",
              "GET /workspaces/{workspaceId}/prompts/{promptId}/versions/{promptVersionId}",
              "PUT /workspaces/{workspaceId}/prompts/{promptId}/versions/{promptVersionId}",
              "DELETE /workspaces/{workspaceId}/prompts/{promptId}/versions/{promptVersionId}",
              "GET /workspaces/{workspaceId}/promptsByName/{promptName}"
            ]
          },
          {
            "group": "Knowledge",
            "icon": "book",
            "openapi": "openapi.yaml",
            "pages": [
              "POST /workspaces/{workspaceId}/documents",
              "GET /workspaces/{workspaceId}/documents",
              "POST /workspaces/{workspaceId}/documents/search",
              "DELETE /workspaces/{workspaceId}/documents/{documentId}"
            ]
          }
        ]
      },
      {
        "tab": "Integrations",
        "icon": "plug",
        "groups": [
          {
            "group": "Integrations",
            "pages": [
              "integrations/overview"
            ]
          }
        ]
      },
      {
        "tab": "Agent Plugins",
        "icon": "puzzle",
        "groups": [
          {
            "group": "Agent Plugins",
            "pages": [
              "agent-plugins/overview"
            ]
          }
        ]
      },
      {
        "tab": "Release Notes",
        "icon": "newspaper",
        "groups": [
          {
            "group": "Release Notes",
            "pages": [
              "release-notes/platform",
              "release-notes/sdk_tools"
            ]
          }
        ]
      }
    ]
  }
}
